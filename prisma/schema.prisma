generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  STAFF
}

enum AssetStatus {
  AVAILABLE
  IN_USE
  UNDER_MAINTENANCE
  RETIRED
  DISPOSED
}

enum AssetCategory {
  IT_EQUIPMENT
  FURNITURE
  VEHICLE
  MACHINERY
  OTHER
}

enum ApprovalType {
  PURCHASE
  DISPOSAL
  TRANSFER
  MAINTENANCE_REQUEST
  RENTAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HistoryType {
  ASSIGNED
  RETURNED
  TRANSFERRED
  MAINTAINED
  DISPOSED
  STATUS_CHANGED
}

enum AuditItemResult {
  PENDING
  CONFIRMED
  MISSING
  SURPLUS
}

// ─── Models ────────────────────────────────────────────────────────────────

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  role       UserRole @default(STAFF)
  department String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assetsApplied  Approval[]     @relation("Applicant")
  assetsApproved Approval[]     @relation("Approver")
  historyLogs    HistoryLog[]
  notifications  Notification[]

  @@map("users")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // 'APPROVAL_REQUEST' | 'APPROVAL_APPROVED' | 'APPROVAL_REJECTED' | 'APPROVAL_CANCELLED' | 'WARRANTY_EXPIRING'
  title     String
  body      String
  link      String?   // 클릭 시 이동할 경로 (예: /approvals)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

model Asset {
  id           String        @id @default(cuid())
  code         String        @unique
  barcode      String?       @unique
  name         String
  category     AssetCategory
  department   String
  location     String
  status       AssetStatus   @default(AVAILABLE)
  price        Decimal       @db.Decimal(12, 2)
  acquiredDate DateTime
  warrantyDate DateTime?
  remarks      String?       // 비고 (TW-AMS remarks 호환)
  subCategory  String?       // 중분류 (예: FR, IT-NB)
  description  String?       // 세부정보 (예: 믹스 일자 사무용책상 Black leg)
  size         String?       // 사이즈 WxDxH (예: 1600x800x720)
  color        String?       // 색상 (예: white, 원목)
  assignedTo   String?       // 담당자 (성명 또는 부서명, 자유텍스트)
  deletedAt    DateTime?     // 소프트 삭제: null이면 활성, 값이 있으면 삭제됨
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  approvals            ApprovalAsset[]
  historyLogs          HistoryLog[]
  maintenanceLogs      MaintenanceLog[]
  maintenanceSchedules MaintenanceSchedule[]
  auditItems           AssetAuditItem[]
  files                AssetFile[]

  @@index([department])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("assets")
}

// Approval ↔ Asset 다대다 조인 테이블
model ApprovalAsset {
  approvalId String
  assetId    String

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([approvalId, assetId])
  @@index([assetId])
  @@map("approval_assets")
}

model Approval {
  id          String         @id @default(cuid())
  title       String
  type        ApprovalType
  status      ApprovalStatus @default(PENDING)
  reason      String?        @db.Text
  applicantId String
  approverId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  applicant User            @relation("Applicant", fields: [applicantId], references: [id])
  approver  User?           @relation("Approver", fields: [approverId], references: [id])
  assets    ApprovalAsset[]
  files     ApprovalFile[]

  @@index([applicantId])
  @@index([approverId])
  @@index([status])
  @@index([createdAt])
  @@map("approvals")
}

model ApprovalFile {
  id          String   @id @default(cuid())
  approvalId  String
  approval    Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  name        String   // 원본 파일명
  storagePath String   // Supabase Storage 경로 (approvals/{approvalId}/{ts}-{name})
  mimeType    String
  size        Int      // bytes
  createdAt   DateTime @default(now())

  @@index([approvalId])
  @@map("approval_files")
}

model HistoryLog {
  id      String      @id @default(cuid())
  assetId String
  userId  String
  date    DateTime    @default(now())
  type    HistoryType
  detail  String      @db.Text

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([assetId])
  @@index([date])
  @@map("history_logs")
}

model MaintenanceLog {
  id        String   @id @default(cuid())
  assetId   String
  date      DateTime
  vendor    String
  cost      Decimal  @db.Decimal(12, 2)
  detail    String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([date])
  @@map("maintenance_logs")
}

model AssetAudit {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime?
  status    String   @default("ACTIVE") // 'ACTIVE' | 'COMPLETED'
  createdBy String   // 실사 담당자 이름
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items AssetAuditItem[]

  @@index([status])
  @@index([createdAt])
  @@map("asset_audits")
}

model AssetAuditItem {
  id        String          @id @default(cuid())
  auditId   String
  assetId   String
  result    AuditItemResult @default(PENDING)
  auditedBy String?         // 처리자 이름
  auditedAt DateTime?
  note      String?

  audit AssetAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  asset Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([auditId, assetId])
  @@index([auditId])
  @@index([assetId])
  @@map("asset_audit_items")
}

model MaintenanceSchedule {
  id           String    @id @default(cuid())
  assetId      String
  asset        Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  description  String    // 점검 내용 설명
  intervalDays Int       // 점검 주기 (일)
  lastDoneAt   DateTime? // 마지막 완료일
  nextDueAt    DateTime  // 다음 점검 예정일
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([assetId])
  @@index([nextDueAt])
  @@map("maintenance_schedules")
}

model AssetFile {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  name        String   // 원본 파일명
  storagePath String   // Supabase Storage 경로 (assets/{assetId}/{ts}-{name})
  mimeType    String
  size        Int      // bytes
  createdAt   DateTime @default(now())

  @@index([assetId])
  @@map("asset_files")
}

// 마스터 데이터 (부서 / 위치 / 벤더 / 카테고리명 등)
// 파일시스템(data/master.json) 대신 DB에서 관리 — Vercel 서버리스 호환
model MasterItem {
  id        String   @id @default(cuid())
  type      String   // 'departments' | 'locations' | 'vendors' | 'categories'
  value     String
  createdAt DateTime @default(now())

  @@unique([type, value])
  @@index([type])
  @@map("master_items")
}
